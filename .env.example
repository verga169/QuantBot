# =====================================================================
# Bybit QuantBot - Environment Configuration Example
# =====================================================================

# Exchange Credentials (Bybit API Key & Secret)
BYBIT_API_KEY=YOUR_BYBIT_API_KEY_HERE
BYBIT_API_SECRET=YOUR_BYBIT_API_SECRET_HERE
BYBIT_TLD=eu
BYBIT_DOMAIN=bybit
BYBIT_DEMO_MODE=true

# Market & Trading Pair
BASE_ASSET=BTC
QUOTE_ASSET=USDC
BYBIT_SYMBOL=BTCUSDC

# Capital Allocation & Sizing
BACKTEST_CAPITAL_EUR=1000
BACKTEST_CAPITAL_USDC=1000
MIN_ORDER_NOTIONAL_EUR=50
MAX_ORDER_NOTIONAL_EUR=1000
MIN_ORDER_NOTIONAL_USDC=50
MAX_ORDER_NOTIONAL_USDC=1000

# Quantitative Risk Management
RISK_PER_TRADE=0.01
VOLATILITY_TARGET_PCT=1.0
EMA200_TREND_FILTER=true
FEE_RATE=0.001
SLIPPAGE_PCT=0.0005
MAX_HOLDING_HOURS=32

# Paper Trading Engine Settings
PAPER_INITIAL_CAPITAL_USDC=1000
PAPER_DAILY_LOSS_LIMIT_PCT=0.035
PAPER_DAILY_LOSS_LIMIT_USDC=35
PAPER_MAX_CONSECUTIVE_LOSSES=2
PAPER_DB_PATH=data/paper_trading_demo.sqlite3
PAPER_POLL_SECONDS=15
PAPER_NEWS_POLL_SECONDS=300

# Localization & Timezone
LOCAL_TIMEZONE=Europe/Rome
